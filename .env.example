# ===== CATECHESENDI : configuration (copier ce fichier en « .env » et le compléter) =====
PORT=3000
# Base PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=catechesendi
PGUSER=catechesendi
PGPASSWORD=mot_de_passe_postgres
# true si la base exige une connexion chiffrée (bases hébergées : Render, Neon, Supabase…)
PGSSL=false
# Longue phrase aléatoire et secrète (sert à protéger les sessions de connexion)
SESSION_SECRET=remplacez-moi-par-une-longue-phrase-aleatoire
# true si le site est en HTTPS (recommandé en production)
COOKIE_SECURE=false
# true si le site est derrière Nginx / un proxy de l'hébergeur
TRUST_PROXY=false
